# Copy this file to deploy/.env before starting.
# NEVER commit deploy/.env.

POSTGRES_IMAGE_TAG=15-alpine
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

ODOO_IMAGE=odoo:19.0
ODOO_MASTER_PASSWORD=CHANGE_ME_STRONG_MASTER_PASSWORD
ODOO_DB_NAME=teq_trust

# Local/dev: 0.0.0.0. For reverse-proxy-only deployments use 127.0.0.1.
ODOO_BIND=0.0.0.0
ODOO_PORT=8069
ODOO_PROXY_MODE=False
ODOO_LIST_DB=False

# Start with 0 workers for first install/debug. Increase after sizing the production server.
ODOO_WORKERS=0
ODOO_LIMIT_TIME_CPU=120
ODOO_LIMIT_TIME_REAL=240
ODOO_MAX_CRON_THREADS=1

# Backup retention used by deploy/scripts/backup.sh
BACKUP_RETENTION_DAYS=14
