<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_teq_calibration_equipment_list" model="ir.ui.view"><field name="name">teq.calibration.equipment.list</field><field name="model">teq.calibration.equipment</field><field name="arch" type="xml"><list><field name="equipment_code"/><field name="name"/><field name="serial_number"/><field name="ownership"/><field name="partner_id"/><field name="last_calibration_date"/><field name="next_due_date"/><field name="due_status" widget="badge"/><field name="assigned_user_id"/></list></field></record>
    <record id="view_teq_calibration_equipment_form" model="ir.ui.view"><field name="name">teq.calibration.equipment.form</field><field name="model">teq.calibration.equipment</field><field name="arch" type="xml"><form><sheet><div class="oe_button_box" name="button_box"><button name="action_view_jobs" type="object" class="oe_stat_button" icon="fa-wrench"><field name="job_count" widget="statinfo" string="Calibration Jobs"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="ownership"/><field name="partner_id" invisible="ownership != 'customer'"/><field name="equipment_code"/><field name="serial_number"/><field name="manufacturer"/><field name="model"/></group><group><field name="range_text"/><field name="resolution"/><field name="unit"/><field name="location"/><field name="assigned_user_id"/><field name="company_id" groups="base.group_multi_company"/></group></group><group string="Calibration Status"><field name="last_calibration_date"/><field name="calibration_interval_months"/><field name="next_due_date" readonly="1"/><field name="due_status" widget="badge"/></group><group string="Traceability" invisible="ownership != 'teq_standard'"><field name="reference_certificate_no"/><field name="traceability_lab"/></group><notebook><page string="Notes"><field name="notes"/></page><page string="Job History"><field name="job_ids" readonly="1"><list><field name="name"/><field name="received_date"/><field name="technician_id"/><field name="state" widget="badge"/><field name="conformity" widget="badge"/></list></field></page></notebook></sheet><chatter/></form></field></record>

    <record id="view_teq_calibration_job_list" model="ir.ui.view"><field name="name">teq.calibration.job.list</field><field name="model">teq.calibration.job</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="equipment_id"/><field name="technician_id"/><field name="scheduled_date"/><field name="state" widget="badge"/><field name="conformity" widget="badge"/><field name="sale_order_id"/><field name="invoice_id"/></list></field></record>
    <record id="view_teq_calibration_job_form" model="ir.ui.view"><field name="name">teq.calibration.job.form</field><field name="model">teq.calibration.job</field><field name="arch" type="xml"><form><header><button name="action_mark_received" type="object" string="Receive" class="btn-primary" invisible="state != 'draft'"/><button name="action_start" type="object" string="Start Calibration" class="btn-primary" invisible="state not in ('draft','received')"/><button name="action_send_to_review" type="object" string="Send to Quality Review" class="btn-primary" invisible="state != 'in_progress'"/><button name="action_mark_done" type="object" string="Approve Calibration" class="btn-primary" invisible="state not in ('review','in_progress')" groups="teq_trust_core.group_teq_calibration_manager"/><button name="action_deliver" type="object" string="Mark Delivered" class="btn-primary" invisible="state != 'done'"/><button name="action_create_certificate" type="object" string="Create Certificate" invisible="state not in ('review','done','delivered')" groups="teq_trust_core.group_teq_calibration_manager"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled','delivered')"/><field name="state" widget="statusbar" statusbar_visible="draft,received,in_progress,review,done,delivered"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_certificates" type="object" class="oe_stat_button" icon="fa-certificate"><field name="certificate_count" widget="statinfo" string="Certificates"/></button><button name="action_open_quotation" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not sale_order_id"><div class="o_stat_info"><span class="o_stat_text">Quotation / Sale</span></div></button><button name="action_open_invoice" type="object" class="oe_stat_button" icon="fa-money" invisible="not invoice_id"><div class="o_stat_info"><span class="o_stat_text">Invoice</span></div></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="partner_id"/><field name="contact_id"/><field name="equipment_id"/><field name="technician_id"/><field name="reference_standard_ids" widget="many2many_tags"/></group><group><field name="received_date"/><field name="scheduled_date"/><field name="started_at"/><field name="completed_date"/><field name="delivered_at"/></group></group><group string="Commercial"><field name="customer_po"/><field name="service_product_id"/><field name="quoted_price"/><field name="sale_order_id" readonly="1"/><field name="invoice_id" readonly="1"/><button name="action_create_quotation" type="object" string="Create Quotation" invisible="sale_order_id"/></group><group string="Method &amp; Status"><field name="method"/><field name="environmental_conditions"/><field name="conformity" widget="badge"/></group><notebook><page string="Results"><field name="result_line_ids"><list editable="bottom"><field name="test_point"/><field name="nominal_value"/><field name="measured_value"/><field name="deviation" readonly="1"/><field name="uncertainty"/><field name="tolerance_min"/><field name="tolerance_max"/><field name="unit"/><field name="outcome" widget="badge" readonly="1"/><field name="notes"/></list></field></page><page string="Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>

    <record id="view_teq_calibration_certificate_list" model="ir.ui.view"><field name="name">teq.calibration.certificate.list</field><field name="model">teq.calibration.certificate</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="equipment_id"/><field name="calibration_date"/><field name="valid_until"/><field name="result" widget="badge"/><field name="state" widget="badge"/><field name="approved_by"/></list></field></record>
    <record id="view_teq_calibration_certificate_form" model="ir.ui.view"><field name="name">teq.calibration.certificate.form</field><field name="model">teq.calibration.certificate</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve Certificate" class="btn-primary" invisible="state != 'draft'" groups="teq_trust_core.group_teq_calibration_manager"/><button name="action_void" type="object" string="Void" invisible="state != 'approved'" groups="teq_trust_core.group_teq_calibration_manager"/><button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state != 'void'" groups="teq_trust_core.group_teq_calibration_manager"/><button name="%(teq_trust_core.action_report_teq_calibration_certificate)d" type="action" string="Print Certificate"/><field name="state" widget="statusbar" statusbar_visible="draft,approved,void"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><field name="job_id"/><field name="partner_id" readonly="1"/><field name="equipment_id" readonly="1"/><field name="calibration_date"/><field name="valid_until" readonly="1"/><field name="result" widget="badge"/><field name="approved_by" readonly="1"/><field name="approved_at" readonly="1"/></group><field name="statement"/></sheet><chatter/></form></field></record>

    <record id="action_teq_calibration_jobs" model="ir.actions.act_window"><field name="name">Calibration Jobs</field><field name="res_model">teq.calibration.job</field><field name="view_mode">list,form</field></record>
    <record id="action_teq_customer_equipment" model="ir.actions.act_window"><field name="name">Customer Instruments</field><field name="res_model">teq.calibration.equipment</field><field name="view_mode">list,form</field><field name="domain">[('ownership','=','customer')]</field><field name="context">{'default_ownership':'customer'}</field></record>
    <record id="action_teq_reference_standards" model="ir.actions.act_window"><field name="name">Reference Standards</field><field name="res_model">teq.calibration.equipment</field><field name="view_mode">list,form</field><field name="domain">[('ownership','=','teq_standard')]</field><field name="context">{'default_ownership':'teq_standard'}</field></record>
    <record id="action_teq_calibration_certificates" model="ir.actions.act_window"><field name="name">Calibration Certificates</field><field name="res_model">teq.calibration.certificate</field><field name="view_mode">list,form</field></record>

    <record id="view_partner_form_teq_calibration" model="ir.ui.view"><field name="name">res.partner.form.teq.calibration</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button name="action_teq_view_equipment" type="object" class="oe_stat_button" icon="fa-tachometer" groups="teq_trust_core.group_teq_calibration_user"><field name="teq_equipment_count" widget="statinfo" string="Instruments"/></button><button name="action_teq_view_calibration_jobs" type="object" class="oe_stat_button" icon="fa-wrench" groups="teq_trust_core.group_teq_calibration_user"><field name="teq_calibration_job_count" widget="statinfo" string="Calibration Jobs"/></button></xpath></field></record>
    <record id="view_order_form_teq_calibration" model="ir.ui.view"><field name="name">sale.order.form.teq.calibration</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button name="action_teq_view_calibration_jobs" type="object" class="oe_stat_button" icon="fa-wrench" groups="teq_trust_core.group_teq_calibration_user"><field name="teq_calibration_job_count" widget="statinfo" string="Calibration Jobs"/></button></xpath><xpath expr="//header" position="inside"><button name="action_teq_create_calibration_job" type="object" string="Create Calibration Job" groups="teq_trust_core.group_teq_calibration_user" invisible="state == 'cancel'"/></xpath></field></record>

    <menuitem id="menu_teq_calibration_root" name="Calibration" sequence="20" groups="teq_trust_core.group_teq_calibration_user"/>
    <menuitem id="menu_teq_calibration_jobs" name="Calibration Jobs" parent="teq_trust_core.menu_teq_calibration_root" action="teq_trust_core.action_teq_calibration_jobs" sequence="10" groups="teq_trust_core.group_teq_calibration_user"/>
    <menuitem id="menu_teq_customer_equipment" name="Customer Instruments" parent="teq_trust_core.menu_teq_calibration_root" action="teq_trust_core.action_teq_customer_equipment" sequence="20" groups="teq_trust_core.group_teq_calibration_user"/>
    <menuitem id="menu_teq_reference_standards" name="Reference Standards" parent="teq_trust_core.menu_teq_calibration_root" action="teq_trust_core.action_teq_reference_standards" sequence="30" groups="teq_trust_core.group_teq_calibration_user"/>
    <menuitem id="menu_teq_certificates" name="Certificates" parent="teq_trust_core.menu_teq_calibration_root" action="teq_trust_core.action_teq_calibration_certificates" sequence="40" groups="teq_trust_core.group_teq_calibration_user"/>
</odoo>
