<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_teq_access" model="ir.ui.view">
        <field name="name">res.users.form.teq.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="TEQ Roles &amp; Access" groups="teq_trust_core.group_teq_master_admin">
                    <field name="teq_access_profile_ids" widget="many2many_tags"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="teq_managed_group_ids" widget="many2many_tags" readonly="1"
                           options="{'no_create': True}"/>
                    <div class="text-muted">
                        Choose one or more TEQ role bundles. Changes are applied immediately using normal Odoo security groups.
                    </div>
                    <button name="action_teq_apply_access_profiles" type="object"
                            string="Re-apply TEQ Roles" class="btn-primary"/>
                    <button name="action_teq_clear_managed_access" type="object"
                            string="Clear TEQ Managed Access"/>
                    <button name="action_teq_grant_full_access" type="object"
                            string="Grant Full Installed-App Access"/>
                    <button name="action_change_password_wizard" type="object"
                            string="Set / Reset Password" class="btn-secondary" invisible="not id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
