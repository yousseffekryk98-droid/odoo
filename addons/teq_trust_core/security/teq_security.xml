<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_teq_administration" model="ir.module.category"><field name="name">TEQ Administration</field><field name="sequence">90</field></record>
    <record id="privilege_teq_administration" model="res.groups.privilege"><field name="name">TEQ Administration</field><field name="sequence">90</field><field name="category_id" ref="teq_trust_core.module_category_teq_administration"/></record>
    <record id="group_teq_master_admin" model="res.groups"><field name="name">Master Administrator</field><field name="sequence">100</field><field name="privilege_id" ref="teq_trust_core.privilege_teq_administration"/><field name="implied_ids" eval="[(4, ref('base.group_system'))]"/><field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/></record>

    <record id="module_category_teq_quality" model="ir.module.category"><field name="name">TEQ Quality &amp; Calibration</field><field name="sequence">25</field></record>
    <record id="privilege_teq_calibration" model="res.groups.privilege"><field name="name">Calibration</field><field name="sequence">10</field><field name="category_id" ref="teq_trust_core.module_category_teq_quality"/></record>
    <record id="group_teq_calibration_user" model="res.groups"><field name="name">User / Technician</field><field name="sequence">10</field><field name="privilege_id" ref="teq_trust_core.privilege_teq_calibration"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
    <record id="group_teq_calibration_manager" model="res.groups"><field name="name">Manager / Quality Approver</field><field name="sequence">20</field><field name="privilege_id" ref="teq_trust_core.privilege_teq_calibration"/><field name="implied_ids" eval="[(4, ref('teq_trust_core.group_teq_calibration_user'))]"/><field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/></record>

    <record id="module_category_teq_documents" model="ir.module.category"><field name="name">TEQ Documents</field><field name="sequence">35</field></record>
    <record id="privilege_teq_sign" model="res.groups.privilege"><field name="name">Document Sign</field><field name="sequence">10</field><field name="category_id" ref="teq_trust_core.module_category_teq_documents"/></record>
    <record id="group_teq_sign_user" model="res.groups"><field name="name">User</field><field name="sequence">10</field><field name="privilege_id" ref="teq_trust_core.privilege_teq_sign"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
    <record id="group_teq_sign_manager" model="res.groups"><field name="name">Manager</field><field name="sequence">20</field><field name="privilege_id" ref="teq_trust_core.privilege_teq_sign"/><field name="implied_ids" eval="[(4, ref('teq_trust_core.group_teq_sign_user'))]"/><field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/></record>

    <record id="module_category_teq_hr" model="ir.module.category"><field name="name">TEQ Human Resources</field><field name="sequence">45</field></record>
    <record id="privilege_teq_appraisal" model="res.groups.privilege"><field name="name">Appraisals</field><field name="sequence">10</field><field name="category_id" ref="teq_trust_core.module_category_teq_hr"/></record>
    <record id="group_teq_appraisal_user" model="res.groups"><field name="name">Employee</field><field name="sequence">10</field><field name="privilege_id" ref="teq_trust_core.privilege_teq_appraisal"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
    <record id="group_teq_appraisal_manager" model="res.groups"><field name="name">Manager</field><field name="sequence">20</field><field name="privilege_id" ref="teq_trust_core.privilege_teq_appraisal"/><field name="implied_ids" eval="[(4, ref('teq_trust_core.group_teq_appraisal_user'))]"/><field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/></record>

    <record id="module_category_teq_esg" model="ir.module.category"><field name="name">TEQ ESG</field><field name="sequence">70</field></record>
    <record id="privilege_teq_esg" model="res.groups.privilege"><field name="name">ESG</field><field name="sequence">10</field><field name="category_id" ref="teq_trust_core.module_category_teq_esg"/></record>
    <record id="group_teq_esg_user" model="res.groups"><field name="name">User</field><field name="sequence">10</field><field name="privilege_id" ref="teq_trust_core.privilege_teq_esg"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
    <record id="group_teq_esg_manager" model="res.groups"><field name="name">Manager</field><field name="sequence">20</field><field name="privilege_id" ref="teq_trust_core.privilege_teq_esg"/><field name="implied_ids" eval="[(4, ref('teq_trust_core.group_teq_esg_user'))]"/><field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/></record>

    <data noupdate="1">
        <record id="rule_teq_calibration_job_user" model="ir.rule"><field name="name">Calibration jobs assigned to user</field><field name="model_id" ref="model_teq_calibration_job"/><field name="domain_force">['|','|',('technician_id','=',user.id),('technician_id','=',False),('create_uid','=',user.id)]</field><field name="groups" eval="[(4, ref('teq_trust_core.group_teq_calibration_user'))]"/></record>
        <record id="rule_teq_calibration_job_manager" model="ir.rule"><field name="name">Calibration managers see all jobs</field><field name="model_id" ref="model_teq_calibration_job"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4, ref('teq_trust_core.group_teq_calibration_manager'))]"/></record>
        <record id="rule_teq_certificate_user" model="ir.rule"><field name="name">Calibration certificates assigned to user</field><field name="model_id" ref="model_teq_calibration_certificate"/><field name="domain_force">['|',('job_id.technician_id','=',user.id),('job_id.technician_id','=',False)]</field><field name="groups" eval="[(4, ref('teq_trust_core.group_teq_calibration_user'))]"/></record>
        <record id="rule_teq_certificate_manager" model="ir.rule"><field name="name">Calibration managers see all certificates</field><field name="model_id" ref="model_teq_calibration_certificate"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4, ref('teq_trust_core.group_teq_calibration_manager'))]"/></record>
        <record id="rule_teq_sign_user" model="ir.rule"><field name="name">Signature requests involving the user</field><field name="model_id" ref="model_teq_sign_request"/><field name="domain_force">['|',('requester_id','=',user.id),('signer_id','=',user.id)]</field><field name="groups" eval="[(4, ref('teq_trust_core.group_teq_sign_user'))]"/></record>
        <record id="rule_teq_sign_manager" model="ir.rule"><field name="name">Signature managers see all requests</field><field name="model_id" ref="model_teq_sign_request"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4, ref('teq_trust_core.group_teq_sign_manager'))]"/></record>
        <record id="rule_teq_appraisal_employee" model="ir.rule"><field name="name">Employees see their own appraisals</field><field name="model_id" ref="model_teq_hr_appraisal"/><field name="domain_force">[('employee_id.user_id','=',user.id)]</field><field name="groups" eval="[(4, ref('teq_trust_core.group_teq_appraisal_user'))]"/></record>
        <record id="rule_teq_appraisal_manager" model="ir.rule"><field name="name">Appraisal managers see all</field><field name="model_id" ref="model_teq_hr_appraisal"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4, ref('teq_trust_core.group_teq_appraisal_manager'))]"/></record>
    </data>
</odoo>
