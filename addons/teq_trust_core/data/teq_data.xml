<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_teq_calibration_job" model="ir.sequence"><field name="name">TEQ Calibration Job</field><field name="code">teq.calibration.job</field><field name="prefix">CAL/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="seq_teq_calibration_certificate" model="ir.sequence"><field name="name">TEQ Calibration Certificate</field><field name="code">teq.calibration.certificate</field><field name="prefix">CERT/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="seq_teq_sign_request" model="ir.sequence"><field name="name">TEQ Signature Request</field><field name="code">teq.sign.request</field><field name="prefix">SIGN/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="ir_cron_teq_calibration_due_reminders" model="ir.cron"><field name="name">TEQ Calibration: Due Reminders</field><field name="model_id" ref="model_teq_calibration_equipment"/><field name="state">code</field><field name="code">model._cron_schedule_due_activities()</field><field name="interval_number">1</field><field name="interval_type">days</field><field name="active">True</field></record>
</odoo>
